# Copy to .env and adjust. Every variable is validated at startup (src/config/app-config.ts).

NODE_ENV=development
PORT=3000

# PostgreSQL (docker compose service "postgres")
DATABASE_URL="postgresql://dti:dti_dev_password@localhost:5432/dti_attendance?schema=public"

# Optional: Redis for shared rate-limit counters. Omit to use in-memory limits (single instance only).
REDIS_URL="redis://localhost:6379"

# Secrets — at least 32 characters each, different from each other. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="dev-only-access-secret-change-me-0123456789"
DEVICE_JWT_SECRET="dev-only-device-secret-change-me-0123456789"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
DEVICE_TOKEN_TTL_SECONDS=3600

# Comma-separated dashboard origins allowed by CORS (empty = CORS disabled)
CORS_ORIGINS="http://localhost:5173"
SWAGGER_ENABLED=true
LOG_LEVEL=info
# Number of reverse proxies in front of the API (for real client IPs in logs/rate limits)
TRUST_PROXY_HOPS=0

# Business timezone default (schedules may set their own)
APP_TIMEZONE="Africa/Lagos"

# Sessions
SESSION_GENERATION_HORIZON_WEEKS=6
SESSION_EARLY_GRACE_MINUTES=60
SESSION_CLOSE_GRACE_MINUTES=30
SESSION_UNRESOLVED_AFTER_HOURS=24

# Periodic session maintenance (generate / auto-close / mark unresolved)
JOBS_ENABLED=true
JOBS_CRON="*/15 * * * *"

# Device sync
SYNC_MAX_BATCH_SIZE=200
SYNC_LOOKAHEAD_DAYS=14
CAPTURE_FUTURE_TOLERANCE_SECONDS=300
CAPTURE_MIN_DATE="2024-01-01"

# Rate limits (requests per minute)
THROTTLE_DEFAULT_PER_MINUTE=300
THROTTLE_LOGIN_PER_MINUTE=10
THROTTLE_DEVICE_TOKEN_PER_MINUTE=20
THROTTLE_SYNC_PER_MINUTE=120

# Used only by `npm run db:seed` to create the first SUPER_ADMIN
SEED_ADMIN_EMAIL="admin@dti.local"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
# Set to true to also create demo data (group, schedule, members, cards, device)
SEED_DEMO_DATA=false
