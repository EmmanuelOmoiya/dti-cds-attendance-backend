{
  "name": "dti-cds-attendance-backend",
  "version": "1.0.0",
  "description": "Offline-first NFC attendance backend for DTI CDS groups",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint:types": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "ts-node --transpile-only src/cli/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "test:all": "jest --runInBand",
    "test:cov": "jest --runInBand --coverage",
    "postinstall": "prisma generate",
    "db:seed:prod": "node dist/cli/seed.js",
    "start:prod": "prisma migrate deploy && node dist/cli/seed.js && node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cron": "4.4.0",
    "dotenv": "17.2.3",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "luxon": "3.7.2",
    "nestjs-pino": "4.6.1",
    "pg": "8.16.3",
    "pino": "10.1.0",
    "pino-http": "11.0.0",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.8",
    "@types/express": "5.0.3",
    "@types/jest": "^29.5.14",
    "@types/luxon": "3.7.1",
    "@types/node": "24.9.1",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
